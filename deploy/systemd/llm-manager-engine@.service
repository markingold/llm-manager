[Unit]
Description=LLM Manager engine slot %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=llm-manager
Group=llm-manager
Environment=LLM_MANAGER_HOME=/var/lib/llm-manager
Environment=LLM_MANAGER_CONFIG_DIR=/etc/llm-manager
Environment=LLM_MANAGER_SECRETS_DIR=/var/lib/llm-manager/secrets
EnvironmentFile=-/etc/llm-manager/llm-manager.env
EnvironmentFile=/etc/llm-manager/engine-%i.env
ExecStart=/usr/bin/python3 /usr/share/llm-manager/run/engine_launcher.py --api-port ${API_PORT} --model ${MODEL_ALIAS} --max-seq-len ${MAX_SEQ_LEN} --listen-host ${LISTEN_HOST}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/llm-manager
ReadWritePaths=/srv/2bananas/engines

[Install]
WantedBy=multi-user.target
