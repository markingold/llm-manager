[Unit]
Description=LLM Manager API (project checkout)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=nova
WorkingDirectory=/srv/2bananas/projects/llm-manager
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/test -f /srv/2bananas/projects/llm-manager/llm_manager/server.py
ExecStart=/srv/2bananas/projects/llm-manager/venv/bin/python -m llm_manager.server
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
