[Unit]
Description=LLM embedding engine (vLLM on :8503)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=nova
Group=www-data
WorkingDirectory=/srv/2bananas/projects/llm-manager
Environment=HF_HUB_DISABLE_TELEMETRY=1
Environment=SERVER_MODELS_DIR=/srv/2bananas/engines/models
Environment=VLLM_PYTHON_BIN=/srv/2bananas/engines/vllm-env/bin/python3
Environment=LLM_EMBED_CUDA_VISIBLE_DEVICES=1
Environment=LLM_EMBED_VLLM_GPU_MEMORY_UTILIZATION=0.20
Environment=LLM_EMBED_VLLM_TENSOR_PARALLEL_SIZE=1
ExecStart=/srv/2bananas/projects/llm-manager/venv/bin/python /srv/2bananas/projects/llm-manager/run/engine_launcher.py --api-port 8503 --model embed_active_model --max-seq-len 512 --listen-host 127.0.0.1
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=10
TimeoutStartSec=180
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
