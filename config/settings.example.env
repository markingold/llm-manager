# ──────────────────────────────────────────────────────────────
# LLM Manager — settings.example.env
# Copy to secrets/.env and edit for your environment.
# ──────────────────────────────────────────────────────────────

# OpenAI-compatible API bases for each engine slot
LLM_CHAT_API_BASE=http://127.0.0.1:8500
LLM_INTENT_API_BASE=http://127.0.0.1:8501
LLM_SMALL_API_BASE=http://127.0.0.1:8502
LLM_EMBED_API_BASE=http://127.0.0.1:8503

# Optional per-backend API base overrides (used when a slot backend is tgw/vllm/tabbyapi/llamacpp)
# If unset, the generic LLM_*_API_BASE value for that slot is used.
# LLM_CHAT_API_BASE_TGW=http://127.0.0.1:8500
# LLM_CHAT_API_BASE_VLLM=http://127.0.0.1:8600
# LLM_CHAT_API_BASE_TABBYAPI=http://127.0.0.1:8500
# LLM_CHAT_API_BASE_LLAMACPP=http://127.0.0.1:8500
# LLM_INTENT_API_BASE_TGW=http://127.0.0.1:8501
# LLM_INTENT_API_BASE_VLLM=http://127.0.0.1:8601
# LLM_INTENT_API_BASE_TABBYAPI=http://127.0.0.1:8701
# LLM_SMALL_API_BASE_TGW=http://127.0.0.1:8502
# LLM_SMALL_API_BASE_VLLM=http://127.0.0.1:8602
# LLM_SMALL_API_BASE_TABBYAPI=http://127.0.0.1:8702
# LLM_EMBED_API_BASE_VLLM=http://127.0.0.1:8503

# Optional explicit TabbyAPI startup command used by run/launch_tabbyapi.py
# TABBYAPI_CMD=/srv/2bananas/engines/llm-env/bin/python3 /srv/2bananas/engines/tabbyapi-src/main.py
# TABBYAPI_ROOT=/srv/2bananas/engines/tabbyapi-src
# TABBYAPI_REVISION=857f9e21dde2b7f10551ed5c5b9845e129b41e6a
# BACKEND_PINS_PATH=/etc/llm-manager/backend-pins.json

# Optional explicit Python interpreter for run/launch_vllm.py.
# Use this when systemd launches engine_launcher with a Python that does not have vllm installed.
# VLLM_PYTHON_BIN=/srv/2bananas/engines/vllm-env/bin/python3

# Optional direct llama.cpp server binary. The bundled TGW binary and PATH are
# auto-detected when this is unset.
# LLAMA_CPP_SERVER_BIN=/usr/local/bin/llama-server

# Per-slot GPU/resource controls. Packaged systemd instances also read the
# corresponding config/engine-<slot>.env values.
# LLM_CHAT_CUDA_VISIBLE_DEVICES=0
# LLM_CHAT_VLLM_GPU_MEMORY_UTILIZATION=0.85
# LLM_CHAT_VLLM_TENSOR_PARALLEL_SIZE=1
# LLM_CHAT_LLAMA_CPP_N_GPU_LAYERS=-1
# LLM_CHAT_LLAMA_CPP_PARALLEL=1
# LLM_CHAT_LLAMA_CPP_TENSOR_SPLIT=1,1

# Optional native Tabby model-load context hints used by /switch and /models/load
# If native_max_seq_len is omitted in the request, lookup order is:
#   LLM_<MODE>_NATIVE_MAX_SEQ_LEN -> LLM_<MODE>_MAX_SEQ_LEN -> TABBYAPI_NATIVE_MAX_SEQ_LEN
# Fallback default is 16384.
# TABBYAPI_NATIVE_MAX_SEQ_LEN=16384
# LLM_CHAT_NATIVE_MAX_SEQ_LEN=16384

# Smart Assistant router
SMART_ASSISTANT_URL=http://127.0.0.1:8100/command

# Default GPU selection for training/conversion
CUDA_VISIBLE_DEVICES=0

# PM2 process names (legacy — prefer systemd units)
PM2_CHAT=llm_a_8500
PM2_INTENT=llm_b_8501
PM2_SMALL=llm_c_8502
PM2_EMBED=llm_embed_8503

# Engine roots
LLM_MANAGER_ENGINES_ROOT=/srv/2bananas/engines
# LLM_MANAGER_HOME=/var/lib/llm-manager
# LLM_MANAGER_CONFIG_DIR=/etc/llm-manager
# LLM_MANAGER_STATE_DIR=/var/lib/llm-manager/run/state
# LLM_MANAGER_LOG_DIR=/var/lib/llm-manager/run/logs
# LLM_MANAGER_SECRETS_DIR=/var/lib/llm-manager/secrets
WEBUI_ROOT=/srv/2bananas/engines/text-generation-webui
# Optional; launch_tgw.py otherwise prefers WEBUI_ROOT/venv/bin/python.
# TGW_PYTHON_BIN=/srv/2bananas/engines/text-generation-webui/venv/bin/python
WEBUI_MODELS_DIR=/srv/2bananas/engines/models
EXLLAMA_ROOT=/srv/2bananas/engines/exllamav2

# Slot visibility (set to 0 to hide a slot in the dashboard)
ENABLE_CHAT=1
ENABLE_INTENT=1
ENABLE_SMALL=1
ENABLE_EMBED=1

# Packaged systemd slot instances
SYSTEMD_LLM_A=llm-manager-engine@chat.service
SYSTEMD_LLM_B=llm-manager-engine@intent.service
SYSTEMD_LLM_C=llm-manager-engine@small.service
SYSTEMD_LLM_D=llm-manager-engine@embed.service

# Model switch/load readiness verification
MODEL_READINESS_TIMEOUT_SECONDS=90

# Optional standalone TGW WebUI controls
TGW_WEBUI_ENABLED=0
TGW_WEBUI_PORT=7860
TGW_WEBUI_BIND_HOST=127.0.0.1
# Optional public launch URL override for the dashboard button
# TGW_WEBUI_PUBLIC_URL=http://your-hostname:7860/

# Hugging Face token (for downloading gated models)
# HF_TOKEN=hf_...

# Provider router settings
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENAI_API_BASE=https://api.openai.com/v1

# Provider API keys (set in secrets/.env on real hosts)
# OPENROUTER_API_KEY=...
# OPENAI_API_KEY=...

# Default routing behavior for upcoming broker endpoints
DEFAULT_ROUTING_STRATEGY=local_first
DEFAULT_FREE_FALLBACK_ALLOWED=1
DEFAULT_PAID_FALLBACK_ALLOWED=1

# Local evaluation worker and queue controls
EVAL_WORKER_COUNT=2
EVAL_MAX_RUNNING_INTERACTIVE=2
EVAL_MAX_RUNNING_BATCH=1
EVAL_MAX_RUNNING_EVALUATION=1
EVAL_RUNNING_STALE_SECONDS=900
EVAL_WORKER_AUTOSTART=1
